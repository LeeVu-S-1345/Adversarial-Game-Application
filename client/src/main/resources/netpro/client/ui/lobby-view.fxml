<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<!-- Lobby (docs/ui-spec.md, section 5). Rows, tiles and the play actions are built by LobbyController. -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="root"
           fx:controller="netpro.client.ui.controller.LobbyController"
           prefWidth="1100" prefHeight="620">
    <stylesheets>
        <URL value="@theme.css"/>
    </stylesheets>

    <BorderPane>
        <top>
            <HBox styleClass="topbar">
                <StackPane fx:id="logoHolder"/>
                <Label text="Adversarial Game" styleClass="cond" style="-fx-font-size: 18px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshButton" text="Refresh" styleClass="btn, ghost, sm" onAction="#onRefresh"/>
                <Region styleClass="vsep" minHeight="24" maxHeight="24"/>
                <StackPane fx:id="meAvatar"/>
                <Label fx:id="meName" styleClass="semi"/>
                <Button fx:id="logoutButton" text="Log out" styleClass="btn, sm" onAction="#onLogout"/>
            </HBox>
        </top>

        <center>
            <HBox spacing="18">
                <padding><Insets top="18" right="20" bottom="16" left="20"/></padding>

                <!-- the "table": choose a game, find an opponent, create a room -->
                <VBox fx:id="table" styleClass="table" prefWidth="300" minWidth="300" maxWidth="300">
                    <Label text="CHOOSE A GAME" styleClass="sec"/>
                    <HBox fx:id="caroTile"/>
                    <HBox fx:id="reversiTile"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <VBox fx:id="matchBox" spacing="6"/>
                    <Region styleClass="hsep-felt"/>
                    <VBox fx:id="roomBox"/>
                </VBox>

                <VBox spacing="14" HBox.hgrow="ALWAYS">
                    <VBox fx:id="invitesBox" spacing="8" visible="false" managed="false">
                        <HBox fx:id="invitesHeader"/>
                        <VBox fx:id="inviteRows" spacing="8"/>
                    </VBox>
                    <VBox fx:id="playersCard" styleClass="card" VBox.vgrow="ALWAYS">
                        <padding><Insets top="14" right="16" bottom="8" left="16"/></padding>
                        <HBox fx:id="playersHeader"/>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                            <VBox fx:id="playerRows"/>
                        </ScrollPane>
                    </VBox>
                </VBox>

                <VBox fx:id="rankCard" styleClass="card" spacing="4" prefWidth="260" minWidth="260" maxWidth="260">
                    <padding><Insets top="14" right="12" bottom="12" left="12"/></padding>
                    <Label fx:id="rankTitle" styleClass="sec">
                        <padding><Insets left="4" bottom="6"/></padding>
                    </Label>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                        <VBox fx:id="rankRows" spacing="2"/>
                    </ScrollPane>
                </VBox>
            </HBox>
        </center>

        <bottom>
            <HBox styleClass="statusbar">
                <Circle radius="3.5" style="-fx-fill: #2f6b4f;"/>
                <Label fx:id="serverLabel" styleClass="mono, faint, small"/>
                <Region styleClass="vsep" minHeight="16" maxHeight="16"/>
                <Label fx:id="statusLabel" styleClass="msg"/>
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>
