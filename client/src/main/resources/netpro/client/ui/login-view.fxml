<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<!-- Login, Register and Reset password (docs/ui-spec.md, section 3). The left panel is netpro.client.ui.LoginArt. -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="root"
           fx:controller="netpro.client.ui.controller.LoginController"
           prefWidth="1100" prefHeight="620">
    <stylesheets>
        <URL value="@theme.css"/>
    </stylesheets>

    <HBox>
        <StackPane fx:id="artHolder"/>
        <AnchorPane HBox.hgrow="ALWAYS">

            <!-- Log in / Create an account -->
            <VBox fx:id="loginForm" spacing="16" prefWidth="380" AnchorPane.leftAnchor="100" AnchorPane.topAnchor="64">
                <Label text="Log in" styleClass="h1"/>
                <VBox spacing="6">
                    <Label text="Username" styleClass="lbl"/>
                    <TextField fx:id="userField" styleClass="inp" onAction="#onLogin"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Password" styleClass="lbl"/>
                    <StackPane alignment="CENTER_RIGHT">
                        <PasswordField fx:id="passField" styleClass="inp, pw" onAction="#onLogin"/>
                        <TextField fx:id="passText" styleClass="inp, pw" onAction="#onLogin" visible="false" managed="false"/>
                        <Button fx:id="eyeButton" styleClass="icon-btn" onAction="#onToggleEye" focusTraversable="false">
                            <StackPane.margin><Insets right="5"/></StackPane.margin>
                            <graphic>
                                <SVGPath styleClass="icon" content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" scaleX="0.8" scaleY="0.8"/>
                            </graphic>
                        </Button>
                    </StackPane>
                </VBox>
                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="rememberBox" text="Remember username"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Forgot password?" styleClass="link" onAction="#onForgot"/>
                </HBox>
                <Button fx:id="loginButton" text="Log in" styleClass="btn, primary, big" maxWidth="Infinity" onAction="#onLogin"/>
                <Label fx:id="statusLabel" styleClass="msg" wrapText="true" minHeight="18"/>
                <Separator/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="No account yet?" styleClass="dim"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="registerButton" text="Create an account" styleClass="btn" onAction="#onRegister"/>
                </HBox>
            </VBox>

            <!-- Reset password (use case 16) -->
            <VBox fx:id="resetForm" spacing="12" prefWidth="380" AnchorPane.leftAnchor="100" AnchorPane.topAnchor="36"
                  visible="false" managed="false">
                <VBox spacing="4">
                    <Label text="Reset password" styleClass="h1"/>
                    <Label text="Enter the recovery code you got when you created the account." styleClass="dim" wrapText="true"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Username" styleClass="lbl"/>
                    <TextField fx:id="rsUser" styleClass="inp"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Recovery code" styleClass="lbl"/>
                    <TextField fx:id="rsCode" styleClass="inp, mono" promptText="8 letters or digits"/>
                </VBox>
                <HBox spacing="10">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="New password" styleClass="lbl"/>
                        <PasswordField fx:id="rsNew" styleClass="inp"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Confirm" styleClass="lbl"/>
                        <PasswordField fx:id="rsConfirm" styleClass="inp" onAction="#onReset"/>
                    </VBox>
                </HBox>
                <Button fx:id="resetButton" text="Reset password" styleClass="btn, primary, big" maxWidth="Infinity" onAction="#onReset"/>
                <Label fx:id="rsStatus" styleClass="msg" wrapText="true" minHeight="18"/>
                <Separator/>
                <Button text="← Back to log in" styleClass="link" onAction="#onBackToLogin"/>
            </VBox>

            <!-- Server status and address -->
            <HBox spacing="10" alignment="CENTER_LEFT" AnchorPane.leftAnchor="60" AnchorPane.bottomAnchor="18">
                <Circle fx:id="serverDot" radius="4"/>
                <Label fx:id="serverLabel" styleClass="dim" style="-fx-font-size: 13px;"/>
                <TextField fx:id="serverField" styleClass="inp, server" promptText="host:port" onAction="#onServerChanged"/>
            </HBox>
        </AnchorPane>
    </HBox>
</StackPane>
