<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<?import java.net.URL?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="netpro.client.ui.controller.LoginController"
           styleClass="root-bg" prefWidth="1100" prefHeight="620">
    <stylesheets>
        <URL value="@login.css"/>
    </stylesheets>

    <HBox alignment="CENTER_RIGHT" spacing="40" maxHeight="Infinity" maxWidth="Infinity">
        <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

        <VBox styleClass="card" prefWidth="420" maxWidth="420" minWidth="420"
              spacing="14" alignment="TOP_CENTER">
            <StackPane styleClass="avatar" minWidth="72" minHeight="72"
                       maxWidth="72" maxHeight="72">
                <SVGPath styleClass="icon-white"
                         content="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                         scaleX="1.5" scaleY="1.5"/>
            </StackPane>
            <Label text="Login" styleClass="card-title"/>
            <Label text="Welcome back!" styleClass="card-subtitle"/>

            <!-- Tên đăng nhập -->
            <HBox fx:id="userBox" styleClass="field-box">
                <SVGPath styleClass="icon"
                         content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                <TextField fx:id="userField" promptText="Username" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Mật khẩu (PasswordField và TextField chồng lên nhau để bật/tắt hiện mật khẩu) -->
            <HBox fx:id="passBox" styleClass="field-box">
                <SVGPath styleClass="icon"
                         content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passField" promptText="Password"/>
                    <TextField fx:id="passText" promptText="Password" visible="false" managed="false"/>
                </StackPane>
                <Button fx:id="eyeButton" styleClass="icon-button" onAction="#onToggleEye">
                    <graphic>
                        <SVGPath styleClass="icon"
                                 content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                    </graphic>
                </Button>
            </HBox>

            <HBox alignment="CENTER_LEFT">
<!--                <CheckBox fx:id="rememberBox" text="Ghi nhớ đăng nhập"/>-->
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot password?" onAction="#onForgot"/>
            </HBox>

            <Button fx:id="loginButton" text="Login" styleClass="primary-button"
                    maxWidth="Infinity" onAction="#onLogin" defaultButton="true">
                <graphic>
                    <SVGPath styleClass="icon-white"
                             content="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/>
                </graphic>
            </Button>

            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="Hoặc" styleClass="card-subtitle"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <Button fx:id="registerButton" text="Register an account" styleClass="secondary-button"
                    maxWidth="Infinity" onAction="#onRegister">
                <graphic>
                    <SVGPath styleClass="icon-white"
                             content="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </graphic>
            </Button>

            <Label fx:id="statusLabel" styleClass="status-label" wrapText="true" textAlignment="CENTER"/>
        </VBox>
    </HBox>

    <!-- Trạng thái server, góc dưới trái -->
    <HBox StackPane.alignment="BOTTOM_LEFT" alignment="CENTER_LEFT" spacing="8"
          maxWidth="-Infinity" maxHeight="-Infinity" pickOnBounds="false">
        <StackPane.margin><Insets left="24" bottom="18"/></StackPane.margin>
        <Circle fx:id="serverDot" radius="6"/>
        <Label fx:id="serverLabel" styleClass="server-label"/>
    </HBox>
</StackPane>